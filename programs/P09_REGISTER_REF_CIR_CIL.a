; Practical 9 : Register-reference instructions CIR, CIL
; Machine     : BasicComputer.cpu (Mano's Basic Computer)
        LDA NUM         ; set-up: AC <- 9, E = 0
        CIR             ; 7080: AC = 4, E = 1
        CIR             ; 7080: AC = 32770 (-32766), E = 0
        CIL             ; 7040: AC = 4, E = 1
        CIL             ; 7040: AC = 9, E = 0
        HLT

NUM:    .data 1 9
